# Kopieren nach .env und ausfüllen. .env selbst ist gitignored, dient nur
# lokal / auf dem Server - niemals mit echten Werten committen.

# Slack-Bot-Token je Workspace (xoxb-...), siehe README "Slack-API-Token erstellen"
SLACK_TOKEN_MUNBW=
SLACK_TOKEN_MUNBB=
SLACK_TOKEN_MUNSH=
SLACK_TOKEN_DMUN=

# Channel-ID (C...) fuer den Testversand je Workspace
TEST_CHANNEL_MUNBW=
TEST_CHANNEL_MUNBB=
TEST_CHANNEL_MUNSH=
TEST_CHANNEL_DMUN=

# Header, den traefik-forward-auth mit der eingeloggten E-Mail befuellt.
# Lokal ohne die Middleware muss man den selbst setzen (z.B. per ModHeader).
AUTH_EMAIL_HEADER=X-Forwarded-User

# Kommagetrennte Liste von E-Mails mit Admin-Rechten
ADMIN_EMAILS=

# MySQL - entweder als Connection-URL (gewinnt, falls gesetzt) ...
# DATABASE_URL=mysql://masterplan:change-me@mysql:3306/masterplan
# ... oder einzeln, passend zu docker-compose.yaml (Service heisst "mysql")
DB_HOST=mysql
DB_PORT=3306
DB_USER=masterplan
DB_PASSWORD=change-me
DB_NAME=masterplan

TZ=Europe/Berlin
